{
  "name": "editor-video",
  "productName": "Editor de Video",
  "version": "0.1.0",
  "description": "Editor de video de escritorio para Mac y Windows",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "ffmpeg-static": "5.3.0",
    "mediabunny": "^1.62.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
